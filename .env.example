# 可选部署配置：没有 .env 也能启动。
# 仅数据库首次初始化时使用；留空则随机生成密码，并在启动日志输出一次。
# 初始化后从数据库读取密码；后续在「系统设置」修改，修改此项不会重置密码。
PRTS_PASSWORD=
# 使用 HTTPS 部署时设为 true；本机 HTTP 开发保持 false。
PRTS_COOKIE_SECURE=false

# AI 服务地址、模型和密钥在登录后的「系统设置」中配置，保存在 SQLite。
# 不再读取 OPENAI_* 环境变量；不要在 VITE_ 变量或前端代码中填写密钥。

# 默认仅监听本机。需要局域网访问时可将 HOST 改为 0.0.0.0。
HOST=127.0.0.1
PORT=8787

# VPS 上使用持久磁盘路径；备份时使用 npm run db:backup。
PRTS_DB_PATH=./data/prts.sqlite
