# 复制此文件为 .env，填写工作台密码后重启后端服务。
# 必填：设置一个独立的长随机密码；留空会拒绝登录和工作台 API 访问。
PRTS_PASSWORD=
# 使用 HTTPS 部署时设为 true；本机 HTTP 开发保持 false。
PRTS_COOKIE_SECURE=false

# 可选：配置真实 AI 服务。
# 密钥仅由服务端读取；不要在 VITE_ 变量或前端代码中填写密钥。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# 默认仅监听本机。需要局域网访问时可将 HOST 改为 0.0.0.0。
HOST=127.0.0.1
PORT=8787
